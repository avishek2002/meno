# OS / editor
.DS_Store

# Maintainer-local agent memory (public repo; workspace-specific context stays local)
CLAUDE.local.md

# Secrets - never committed
.env

# Tenant content: everything a user generates or supplies is theirs and stays local.
# content/ is the single root for all learning material; only content/tenants/ is
# private. The rule is one absolute prefix - never a negation (!) pattern - and the
# leakage-guard hook (tools/meno-init) refuses anything under content/ that is not
# explicitly community/ or org/. The committed example tenant lives under examples/,
# outside content/, on purpose: no gitignore rule can ever hide it or leak a real
# tenant alongside it.
content/tenants/

# Agent worktrees: `.claude/` is committed (the skill symlinks live there), so
# without this rule a worktree checked out under it shows up as untracked in the
# parent clone and can be committed by accident.
.claude/worktrees/

# Node. No trailing slash: an agent worktree links node_modules rather than
# creating a directory, and `node_modules/` matches only the directory form, so
# the link showed up as untracked and one `git add -A` away from being committed
# as an absolute-path symlink.
node_modules
app/client/dist/
