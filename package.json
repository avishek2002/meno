{
  "name": "meno",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/server/index.ts",
    "dev": "node app/server/index.ts --dev",
    "build": "vite build --config app/client/vite.config.ts",
    "validate": "node tools/validate.ts",
    "eval": "node tools/eval.ts",
    "insights": "node tools/insights.ts",
    "scan": "node tools/scan.ts",
    "cost": "node tools/cost.ts",
    "export": "node tools/export.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/client/tsconfig.json",
    "test": "node --test tools/test/*.test.ts app/test/*.test.ts",
    "gate": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "mermaid": "^11.16.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
