{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avishek2002/meno/schemas/cost.schema.json",
  "title": "Meno content-cost snapshot",
  "description": "The aggregate cost snapshot written by tools/cost.ts to content/tenants/<tenant>/cost/snapshot.json and read by GET /api/v1/:tenant/cost. Aggregates only: no transcript content of any kind. Shape owned by lib/cost.ts; behavior owned by docs/specs/cost.md. additionalProperties is false on purpose - this file is machine-produced, so an unexpected key means the producer drifted from the contract.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "tenant",
    "generated_at",
    "prices_as_of",
    "source",
    "source_label",
    "totals",
    "courses",
    "no_data",
    "shared_orchestration",
    "limits"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "type": { "const": "cost" },
    "tenant": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "prices_as_of": {
      "type": "string",
      "description": "YYYY-MM-DD, or the empty string when no source was available.",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "source": {
      "type": ["string", "null"],
      "description": "Machine name of the cost source, kebab-case, or null when none was available.",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source_label": { "type": ["string", "null"], "minLength": 1 },
    "totals": {
      "type": "object",
      "required": [
        "attributed_usd",
        "shared_orchestration_usd",
        "courses_with_data",
        "courses_without_data",
        "transcripts_scanned",
        "requests"
      ],
      "properties": {
        "attributed_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of the rounded courses[].cost_usd. Never summed with shared_orchestration_usd."
        },
        "shared_orchestration_usd": { "type": "number", "minimum": 0 },
        "courses_with_data": { "type": "integer", "minimum": 0 },
        "courses_without_data": { "type": "integer", "minimum": 0 },
        "transcripts_scanned": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "courses": {
      "type": "array",
      "description": "Descending by cost_usd, then ascending by course, then ascending by dir. A course with no evidence is never here.",
      "items": {
        "type": "object",
        "required": ["course", "dir", "cost_usd", "transcripts", "requests", "scope"],
        "properties": {
          "course": { "type": "string", "minLength": 1 },
          "dir": { "type": "string", "minLength": 1 },
          "cost_usd": { "type": "number", "exclusiveMinimum": 0 },
          "transcripts": { "type": "integer", "minimum": 1 },
          "requests": { "type": "integer", "minimum": 0 },
          "scope": { "enum": ["full", "generation-only"] }
        },
        "additionalProperties": false
      }
    },
    "no_data": {
      "type": "array",
      "description": "Course directories on disk with zero credited evidence, sorted by dir - the unique key. Never rendered as a dollar figure.",
      "items": {
        "type": "object",
        "required": ["course", "dir"],
        "properties": {
          "course": { "type": "string", "minLength": 1 },
          "dir": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "shared_orchestration": {
      "type": "object",
      "description": "Cost that belongs to no single course: sessions that wrote several, or supervised the sub-agents that did. Shown whole, never divided.",
      "required": ["cost_usd", "transcripts", "requests", "courses", "transcript_ids"],
      "properties": {
        "cost_usd": { "type": "number", "minimum": 0 },
        "transcripts": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "courses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "transcript_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "array",
      "description": "The disclosures the page renders verbatim. Never empty: the first two are unconditional.",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
