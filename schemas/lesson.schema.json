{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avishek2002/meno/schemas/lesson.schema.json",
  "title": "Meno lesson frontmatter",
  "description": "Machine-checkable half of the canonical format owned by .agents/skills/generate-module/references/lesson-format.md. Body rules (nine-part anatomy, check blocks) are enforced by tools/validate.ts via the shared lesson parser.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "module",
    "type",
    "objectives",
    "concepts",
    "prerequisites",
    "estimated_minutes",
    "difficulty",
    "status",
    "generated_at",
    "review_after",
    "review_offsets",
    "sources",
    "tags"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[0-9]{2}-[a-z0-9-]+/[0-9]{2}-[a-z0-9-]+$",
      "description": "course-slug/module-slug/lesson-slug"
    },
    "title": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "enum": ["lesson", "practice", "review"] },
    "objectives": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "concepts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "estimated_minutes": { "type": "number", "exclusiveMinimum": 0 },
    "difficulty": { "enum": ["intro", "core", "stretch"] },
    "status": { "enum": ["generated", "reviewed", "stale"] },
    "generated_at": { "type": "string", "format": "date" },
    "review_after": { "type": "string", "format": "date" },
    "review_offsets": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://github.com/avishek2002/meno/schemas/source.schema.json" }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
