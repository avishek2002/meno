#!/bin/sh
# meno-init - one-time setup after cloning meno. Idempotent; run it again anytime.
#   - installs the leakage-guard pre-commit hook (default-deny under content/:
#     only content/community/ and content/org/ may be committed)
#   - creates your tenant directory under content/tenants/
#   - reports which agent CLIs are installed
#   - points at the private-mirror walkthrough
# Usage: tools/meno-init [tenant-name]   (default tenant: main)
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
TENANT=${1:-main}

# 1. the leakage guard: gitignore already hides content/tenants/; this hook is
#    default-deny under content/ - any staged path there is refused unless it is
#    under content/community/ or content/org/, which closes both the one path
#    around the gitignore (git add -f) and unexpected subdirs like
#    content/alice/. Installed in BOTH hook locations, because git
#    consults exactly one of them: .git/hooks when no core.hooksPath is set, or
#    the configured hooksPath directory otherwise (many setups point a global
#    hooksPath at personal hooks that chain to the repo's .githooks/).
GUARD='#!/bin/sh
# meno-leakage-guard: default-deny under content/ - only community/ and org/ are
# committable; tenant vaults and anything unexpected must never reach the public
# repository. -z keeps paths as raw bytes: without it, core.quotePath C-quotes
# non-ASCII names in surrounding double quotes and they evade the ^content/ grep.
staged=$(git diff --cached --name-only -z | tr "\0" "\n" | grep "^content/" | grep -v -e "^content/community/" -e "^content/org/" || true)
if [ -n "$staged" ]; then
  echo "meno: refusing to commit content/ paths outside community/ and org/ (private by design):" >&2
  echo "$staged" | sed "s/^/  /" >&2
  echo "unstage with: git restore --staged <path>  (use tools/meno-mirror for backups)" >&2
  exit 1
fi
[ -x "$0.pre-meno" ] && exec "$0.pre-meno"
exit 0'

install_guard() {
  hook_file=$1
  mkdir -p "$(dirname "$hook_file")"
  if [ -f "$hook_file" ] && grep -q meno-leakage-guard "$hook_file"; then
    return 1
  fi
  [ -f "$hook_file" ] && mv "$hook_file" "$hook_file.pre-meno"
  printf '%s\n' "$GUARD" > "$hook_file"
  chmod +x "$hook_file"
  return 0
}

installed=""
install_guard "$ROOT/.git/hooks/pre-commit" && installed=".git/hooks"
install_guard "$ROOT/.githooks/pre-commit" && installed="$installed .githooks"
if [ -n "$installed" ]; then
  echo "leakage guard: installed at$installed"
else
  echo "leakage guard: already installed"
fi

# an active core.hooksPath overrides .git/hooks entirely - warn when neither
# installed location would actually run
hooks_path=$(git -C "$ROOT" config --get core.hooksPath 2>/dev/null || true)
case "$hooks_path" in
  ""|.githooks|"$ROOT/.githooks") ;;
  *)
    echo ""
    echo "WARNING: git is configured with core.hooksPath=$hooks_path, so repo hooks in"
    echo ".git/hooks are IGNORED. The leakage guard will only run if that hook chains to"
    echo "this repo's .githooks/pre-commit. If it does not, either add that chaining or"
    echo "run:  git -C \"$ROOT\" config --local core.hooksPath .githooks"
    echo "(note: a local hooksPath disables your global hooks for this repo)"
    ;;
esac

# 2. tenant directory (vault files come from the interview's bootstrap)
if [ -d "$ROOT/content/tenants/$TENANT" ]; then
  echo "tenant: content/tenants/$TENANT already exists"
else
  mkdir -p "$ROOT/content/tenants/$TENANT"
  echo "tenant: created content/tenants/$TENANT"
fi

# 3. agent CLI census
echo "agent CLIs found:"
found=0
for cli in claude codex gemini; do
  if command -v "$cli" >/dev/null 2>&1; then echo "  - $cli ($(command -v "$cli"))"; found=1; fi
done
[ "$found" = 1 ] || echo "  - none found; install an agent CLI (Claude Code is first-class)"

# 4. next steps
cat <<EOF

next steps:
  1. npm install && npm start        the study app on http://127.0.0.1:7373
  2. ask your agent what you want to learn - the interview takes it from there
  3. back your content up early:     tools/meno-mirror init $TENANT
     (docs/how-meno-works.md explains the private mirror and the manual fallback)
EOF
